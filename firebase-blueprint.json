{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Represents the user's profile, settings preferences, and coin wallet for rewards in Minima Keyboard.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Unique user ID matching auth.uid" },
        "displayName": { "type": "string", "description": "Display name from Google Account" },
        "email": { "type": "string", "description": "Email address" },
        "coinBalance": { "type": "integer", "description": "Available coin balance for gift card redemptions" },
        "activeThemeId": { "type": "string", "description": "Selected keyboard theme identifier" },
        "activeLanguage": { "type": "string", "description": "Selected typing language code" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp via serverTimestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last updated timestamp via serverTimestamp" }
      },
      "required": ["userId", "coinBalance", "createdAt", "updatedAt"]
    },
    "Redemption": {
      "title": "Redemption",
      "description": "A record of an earned gift card redeemed by the user with their coins.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique redemption ID" },
        "userId": { "type": "string", "description": "Owner user ID matching auth.uid" },
        "cardTitle": { "type": "string", "description": "Gift card name, e.g. Google Play $5" },
        "cardValue": { "type": "string", "description": "Gift card monetary value" },
        "code": { "type": "string", "description": "Redeemed digital voucher code" },
        "cost": { "type": "integer", "description": "Coins spent to redeem" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Redemption timestamp via serverTimestamp" }
      },
      "required": ["id", "userId", "cardTitle", "cardValue", "code", "cost", "createdAt"]
    },
    "CustomTheme": {
      "title": "CustomTheme",
      "description": "User created custom keyboard color theme.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique theme ID" },
        "userId": { "type": "string", "description": "Owner user ID matching auth.uid" },
        "name": { "type": "string", "description": "Custom theme name" },
        "backgroundColorHex": { "type": "string", "description": "Background color hex code" },
        "keyColorHex": { "type": "string", "description": "Keycap surface color hex code" },
        "textColorHex": { "type": "string", "description": "Key legend text color hex code" },
        "accentColorHex": { "type": "string", "description": "Special accent color hex code" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp via serverTimestamp" }
      },
      "required": ["id", "userId", "name", "backgroundColorHex", "keyColorHex", "textColorHex", "accentColorHex", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "UserProfile" },
      "description": "User profile, coin wallet, and preferences"
    },
    "/users/{userId}/redemptions/{redemptionId}": {
      "schema": { "$ref": "Redemption" },
      "description": "Redeemed gift cards for the user"
    },
    "/users/{userId}/custom_themes/{themeId}": {
      "schema": { "$ref": "CustomTheme" },
      "description": "Custom keyboard themes crafted by the user"
    }
  }
}
